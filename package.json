{
  "name": "codeindex-sync",
  "version": "0.1.0",
  "description": "Git-hook-driven index sync worker for MCP code-search backends",
  "type": "module",
  "license": "MIT",
  "bin": {
    "codeindex-sync": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "lint": "eslint src test"
  },
  "keywords": [
    "mcp",
    "code-search",
    "semantic-search",
    "git-hooks",
    "indexing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgd43b/codeindex-sync.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
